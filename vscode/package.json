{
  "name": "localchat",
  "displayName": "AFO",
  "description": "Tells the AFO hub on this computer what you do in VS Code: the open file and the commands run in your terminals.",
  "version": "0.1.0",
  "publisher": "localchat",
  "license": "GPL-3.0-or-later",
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "localchat.setToken",
        "title": "%command.setToken%"
      },
      {
        "command": "localchat.status",
        "title": "%command.status%"
      }
    ],
    "configuration": {
      "title": "AFO",
      "properties": {
        "localchat.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%"
        },
        "localchat.hubUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "%config.hubUrl%"
        },
        "localchat.sendOutput": {
          "type": "boolean",
          "default": true,
          "description": "%config.sendOutput%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/lib.test.js"
  }
}
